# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file is the committed
# template — it documents WHICH variables are needed, never their values.
# If you add a new variable to `.env`, add the key here too (with a placeholder,
# not the secret) so the next person knows it exists.

# Anthropic Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key. Safe to expose to the browser; RLS policies still apply.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx

# Service role key. BYPASSES row-level security — full read/write on every table.
# Server-side only. Never ship this to the frontend, never log it, never paste it
# into an issue, a chat, or a screenshot.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx
